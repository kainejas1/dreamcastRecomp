X(STS_MACL,    "0000nnnn00011010", "sts",     "macl,%n",        E_NONE, F_WN)
X(STS_PR,      "0000nnnn00101010", "sts",     "pr,%n",          E_NONE, F_WN)
X(STSL_MACH,   "0100nnnn00000010", "sts.l",   "mach,@-%n",      E_NONE, F_STORE | F_WN)
X(STSL_MACL,   "0100nnnn00010010", "sts.l",   "macl,@-%n",      E_NONE, F_STORE | F_WN)
X(STSL_PR,     "0100nnnn00100010", "sts.l",   "pr,@-%n",        E_NONE, F_STORE | F_WN)
X(TRAPA,       "11000011iiiiiiii", "trapa",   "%i",             E_IMMU, F_TRAP)
X(NOP,         "0000000000001001", "nop",     "",               E_NONE, 0)

/* ---- FPU ---- */
X(FMOV,        "1111nnnnmmmm1100", "fmov",    "%g,%f",          E_NONE, F_FPU | F_FPMODE)
X(FMOV_LOAD,   "1111nnnnmmmm1000", "fmov.s",  "@%m,%f",         E_NONE, F_FPU | F_FPMODE | F_LOAD)
X(FMOV_STORE,  "1111nnnnmmmm1010", "fmov.s",  "%g,@%n",         E_NONE, F_FPU | F_FPMODE | F_STORE)
X(FMOV_RESTORE,"1111nnnnmmmm1001", "fmov.s",  "@%m+,%f",        E_NONE, F_FPU | F_FPMODE | F_LOAD | F_WM)
X(FMOV_SAVE,   "1111nnnnmmmm1011", "fmov.s",  "%g,@-%n",        E_NONE, F_FPU | F_FPMODE | F_STORE | F_WN)
X(FMOV_INDEX_LOAD,  "1111nnnnmmmm0110", "fmov.s", "@(r0,%m),%f", E_NONE, F_FPU | F_FPMODE | F_LOAD)
X(FMOV_INDEX_STORE, "1111nnnnmmmm0111", "fmov.s", "%g,@(r0,%n)", E_NONE, F_FPU | F_FPMODE | F_STORE)
X(FLDI0,       "1111nnnn10001101", "fldi0",   "%f",             E_NONE, F_FPU)
X(FLDI1,       "1111nnnn10011101", "fldi1",   "%f",             E_NONE, F_FPU)
X(FLDS,        "1111nnnn00011101", "flds",    "%f,fpul",        E_NONE, F_FPU)
X(FSTS,        "1111nnnn00001101", "fsts",    "fpul,%f",        E_NONE, F_FPU)
X(FABS,        "1111nnnn01011101", "fabs",    "%f",             E_NONE, F_FPU | F_FPMODE)
X(FNEG,        "1111nnnn01001101", "fneg",    "%f",             E_NONE, F_FPU | F_FPMODE)
