/*
 * SH-4 instruction table (X-macro).
 *
 *   X(id, pattern, mnemonic, operands, encoding, flags)
 *
 * pattern:  16 chars, MSB first. '0'/'1' are fixed bits; any letter is a
 *           field and is ignored for matching. Fields are always extracted
 *           by position, not by letter:
 *             n = bits 11-8, m = bits 7-4, low 4/8/12 bits per encoding.
 * operands: GNU objdump syntax template.
 *             %n r{n}       %m r{m}       %k r{m&7}_bank
 *             %i #imm       %d disp (scaled, decimal)   %a absolute target
 *             %f fr{n}      %g fr{m}      %D dr{n}
 *             %V fv{n&12}   %W fv{(n&3)*4}
 *
 * The decoder picks the matching entry with the most fixed bits, so row
 * order does not matter.
 *
 * F_WN / F_WM / F_WR0 mark which general register an instruction writes
 * (r{n}, r{m} via @Rm+, or r0). The selftest cross-checks them against the
 * operand template.
 *
 * FPU ops marked F_FPMODE change meaning with FPSCR.SZ / FPSCR.PR
 * (single vs double, fmov 32 vs 64 bit). The disassembler prints the
 * single-precision form, like objdump; the recompiler must track the mode.
 */

/* ---- data transfer ---- */
X(MOV_I,       "1110nnnniiiiiiii", "mov",     "%i,%n",          E_IMMS, F_WN)
X(MOVW_PC,     "1001nnnndddddddd", "mov.w",   "%a,%n",          E_PCW,  F_LOAD | F_PCREL | F_WN)
X(MOVL_PC,     "1101nnnndddddddd", "mov.l",   "%a,%n",          E_PCL,  F_LOAD | F_PCREL | F_WN)
X(MOV,         "0110nnnnmmmm0011", "mov",     "%m,%n",          E_NONE, F_WN)
X(MOVB_S,      "0010nnnnmmmm0000", "mov.b",   "%m,@%n",         E_NONE, F_STORE)
X(MOVW_S,      "0010nnnnmmmm0001", "mov.w",   "%m,@%n",         E_NONE, F_STORE)
X(MOVL_S,      "0010nnnnmmmm0010", "mov.l",   "%m,@%n",         E_NONE, F_STORE)
X(MOVB_L,      "0110nnnnmmmm0000", "mov.b",   "@%m,%n",         E_NONE, F_LOAD | F_WN)
X(MOVW_L,      "0110nnnnmmmm0001", "mov.w",   "@%m,%n",         E_NONE, F_LOAD | F_WN)
X(MOVL_L,      "0110nnnnmmmm0010", "mov.l",   "@%m,%n",         E_NONE, F_LOAD | F_WN)
X(MOVB_SDEC,   "0010nnnnmmmm0100", "mov.b",   "%m,@-%n",        E_NONE, F_STORE | F_WN)
X(MOVW_SDEC,   "0010nnnnmmmm0101", "mov.w",   "%m,@-%n",        E_NONE, F_STORE | F_WN)
X(MOVL_SDEC,   "0010nnnnmmmm0110", "mov.l",   "%m,@-%n",        E_NONE, F_STORE | F_WN)
X(MOVB_LINC,   "0110nnnnmmmm0100", "mov.b",   "@%m+,%n",        E_NONE, F_LOAD | F_WN | F_WM)
X(MOVW_LINC,   "0110nnnnmmmm0101", "mov.w",   "@%m+,%n",        E_NONE, F_LOAD | F_WN | F_WM)
X(MOVL_LINC,   "0110nnnnmmmm0110", "mov.l",   "@%m+,%n",        E_NONE, F_LOAD | F_WN | F_WM)
X(MOVB_S4,     "10000000mmmmdddd", "mov.b",   "r0,@(%d,%m)",    E_D4B,  F_STORE)
X(MOVW_S4,     "10000001mmmmdddd", "mov.w",   "r0,@(%d,%m)",    E_D4W,  F_STORE)
X(MOVL_S4,     "0001nnnnmmmmdddd", "mov.l",   "%m,@(%d,%n)",    E_D4L,  F_STORE)
X(MOVB_L4,     "10000100mmmmdddd", "mov.b",   "@(%d,%m),r0",    E_D4B,  F_LOAD | F_WR0)
X(MOVW_L4,     "10000101mmmmdddd", "mov.w",   "@(%d,%m),r0",    E_D4W,  F_LOAD | F_WR0)
X(MOVL_L4,     "0101nnnnmmmmdddd", "mov.l",   "@(%d,%m),%n",    E_D4L,  F_LOAD | F_WN)
X(MOVB_S0,     "0000nnnnmmmm0100", "mov.b",   "%m,@(r0,%n)",    E_NONE, F_STORE)
X(MOVW_S0,     "0000nnnnmmmm0101", "mov.w",   "%m,@(r0,%n)",    E_NONE, F_STORE)
X(MOVL_S0,     "0000nnnnmmmm0110", "mov.l",   "%m,@(r0,%n)",    E_NONE, F_STORE)
X(MOVB_L0,     "0000nnnnmmmm1100", "mov.b",   "@(r0,%m),%n",    E_NONE, F_LOAD | F_WN)
X(MOVW_L0,     "0000nnnnmmmm1101", "mov.w",   "@(r0,%m),%n",    E_NONE, F_LOAD | F_WN)
X(MOVL_L0,     "0000nnnnmmmm1110", "mov.l",   "@(r0,%m),%n",    E_NONE, F_LOAD | F_WN)
X(MOVB_SG,     "11000000dddddddd", "mov.b",   "r0,@(%d,gbr)",   E_D8B,  F_STORE)
X(MOVW_SG,     "11000001dddddddd", "mov.w",   "r0,@(%d,gbr)",   E_D8W,  F_STORE)
X(MOVL_SG,     "11000010dddddddd", "mov.l",   "r0,@(%d,gbr)",   E_D8L,  F_STORE)
X(MOVB_LG,     "11000100dddddddd", "mov.b",   "@(%d,gbr),r0",   E_D8B,  F_LOAD | F_WR0)
X(MOVW_LG,     "11000101dddddddd", "mov.w",   "@(%d,gbr),r0",   E_D8W,  F_LOAD | F_WR0)
X(MOVL_LG,     "11000110dddddddd", "mov.l",   "@(%d,gbr),r0",   E_D8L,  F_LOAD | F_WR0)
X(MOVA,        "11000111dddddddd", "mova",    "%a,r0",          E_PCL,  F_PCREL | F_WR0)
X(MOVT,        "0000nnnn00101001", "movt",    "%n",             E_NONE, F_WN)
X(SWAPB,       "0110nnnnmmmm1000", "swap.b",  "%m,%n",          E_NONE, F_WN)
X(SWAPW,       "0110nnnnmmmm1001", "swap.w",  "%m,%n",          E_NONE, F_WN)
X(XTRCT,       "0010nnnnmmmm1101", "xtrct",   "%m,%n",          E_NONE, F_WN)
X(MOVCAL,      "0000nnnn11000011", "movca.l", "r0,@%n",         E_NONE, F_STORE)

/* ---- arithmetic ---- */
X(ADD,         "0011nnnnmmmm1100", "add",     "%m,%n",          E_NONE, F_WN)
X(ADD_I,       "0111nnnniiiiiiii", "add",     "%i,%n",          E_IMMS, F_WN)
X(ADDC,        "0011nnnnmmmm1110", "addc",    "%m,%n",          E_NONE, F_WN)
X(ADDV,        "0011nnnnmmmm1111", "addv",    "%m,%n",          E_NONE, F_WN)
X(CMPEQ_I,     "10001000iiiiiiii", "cmp/eq",  "%i,r0",          E_IMMS, 0)
X(CMPEQ,       "0011nnnnmmmm0000", "cmp/eq",  "%m,%n",          E_NONE, 0)
X(CMPHS,       "0011nnnnmmmm0010", "cmp/hs",  "%m,%n",          E_NONE, 0)
X(CMPGE,       "0011nnnnmmmm0011", "cmp/ge",  "%m,%n",          E_NONE, 0)
X(CMPHI,       "0011nnnnmmmm0110", "cmp/hi",  "%m,%n",          E_NONE, 0)
X(CMPGT,       "0011nnnnmmmm0111", "cmp/gt",  "%m,%n",          E_NONE, 0)
X(CMPPL,       "0100nnnn00010101", "cmp/pl",  "%n",             E_NONE, 0)
X(CMPPZ,       "0100nnnn00010001", "cmp/pz",  "%n",             E_NONE, 0)
X(CMPSTR,      "0010nnnnmmmm1100", "cmp/str", "%m,%n",          E_NONE, 0)
X(DIV1,        "0011nnnnmmmm0100", "div1",    "%m,%n",          E_NONE, F_WN)
X(DIV0S,       "0010nnnnmmmm0111", "div0s",   "%m,%n",          E_NONE, 0)
X(DIV0U,       "0000000000011001", "div0u",   "",               E_NONE, 0)
X(DMULS,       "0011nnnnmmmm1101", "dmuls.l", "%m,%n",          E_NONE, 0)
X(DMULU,       "0011nnnnmmmm0101", "dmulu.l", "%m,%n",          E_NONE, 0)
X(DT,          "0100nnnn00010000", "dt",      "%n",             E_NONE, F_WN)
X(EXTSB,       "0110nnnnmmmm1110", "exts.b",  "%m,%n",          E_NONE, F_WN)
X(EXTSW,       "0110nnnnmmmm1111", "exts.w",  "%m,%n",          E_NONE, F_WN)
X(EXTUB,       "0110nnnnmmmm1100", "extu.b",  "%m,%n",          E_NONE, F_WN)
X(EXTUW,       "0110nnnnmmmm1101", "extu.w",  "%m,%n",          E_NONE, F_WN)
X(MACL,        "0000nnnnmmmm1111", "mac.l",   "@%m+,@%n+",      E_NONE, F_LOAD | F_WN | F_WM)
X(MACW,        "0100nnnnmmmm1111", "mac.w",   "@%m+,@%n+",      E_NONE, F_LOAD | F_WN | F_WM)
X(MULL,        "0000nnnnmmmm0111", "mul.l",   "%m,%n",          E_NONE, 0)
X(MULSW,       "0010nnnnmmmm1111", "muls.w",  "%m,%n",          E_NONE, 0)
X(MULUW,       "0010nnnnmmmm1110", "mulu.w",  "%m,%n",          E_NONE, 0)
X(NEG,         "0110nnnnmmmm1011", "neg",     "%m,%n",          E_NONE, F_WN)
X(NEGC,        "0110nnnnmmmm1010", "negc",    "%m,%n",          E_NONE, F_WN)
X(SUB,         "0011nnnnmmmm1000", "sub",     "%m,%n",          E_NONE, F_WN)
X(SUBC,        "0011nnnnmmmm1010", "subc",    "%m,%n",          E_NONE, F_WN)
X(SUBV,        "0011nnnnmmmm1011", "subv",    "%m,%n",          E_NONE, F_WN)

/* ---- logic ---- */
X(AND,         "0010nnnnmmmm1001", "and",     "%m,%n",          E_NONE, F_WN)
X(AND_I,       "11001001iiiiiiii", "and",     "%i,r0",          E_IMMU, F_WR0)
X(ANDB,        "11001101iiiiiiii", "and.b",   "%i,@(r0,gbr)",   E_IMMU, F_LOAD | F_STORE)
X(NOT,         "0110nnnnmmmm0111", "not",     "%m,%n",          E_NONE, F_WN)
X(OR,          "0010nnnnmmmm1011", "or",      "%m,%n",          E_NONE, F_WN)
X(OR_I,        "11001011iiiiiiii", "or",      "%i,r0",          E_IMMU, F_WR0)
X(ORB,         "11001111iiiiiiii", "or.b",    "%i,@(r0,gbr)",   E_IMMU, F_LOAD | F_STORE)
X(TASB,        "0100nnnn00011011", "tas.b",   "@%n",            E_NONE, F_LOAD | F_STORE)
X(TST,         "0010nnnnmmmm1000", "tst",     "%m,%n",          E_NONE, 0)
X(TST_I,       "11001000iiiiiiii", "tst",     "%i,r0",          E_IMMU, 0)
X(TSTB,        "11001100iiiiiiii", "tst.b",   "%i,@(r0,gbr)",   E_IMMU, F_LOAD)
X(XOR,         "0010nnnnmmmm1010", "xor",     "%m,%n",          E_NONE, F_WN)
X(XOR_I,       "11001010iiiiiiii", "xor",     "%i,r0",          E_IMMU, F_WR0)
X(XORB,        "11001110iiiiiiii", "xor.b",   "%i,@(r0,gbr)",   E_IMMU, F_LOAD | F_STORE)

/* ---- shifts ---- */
X(ROTL,        "0100nnnn00000100", "rotl",    "%n",             E_NONE, F_WN)
X(ROTR,        "0100nnnn00000101", "rotr",    "%n",             E_NONE, F_WN)
X(ROTCL,       "0100nnnn00100100", "rotcl",   "%n",             E_NONE, F_WN)
X(ROTCR,       "0100nnnn00100101", "rotcr",   "%n",             E_NONE, F_WN)
X(SHAD,        "0100nnnnmmmm1100", "shad",    "%m,%n",          E_NONE, F_WN)
X(SHAL,        "0100nnnn00100000", "shal",    "%n",             E_NONE, F_WN)
X(SHAR,        "0100nnnn00100001", "shar",    "%n",             E_NONE, F_WN)
X(SHLD,        "0100nnnnmmmm1101", "shld",    "%m,%n",          E_NONE, F_WN)
X(SHLL,        "0100nnnn00000000", "shll",    "%n",             E_NONE, F_WN)
X(SHLR,        "0100nnnn00000001", "shlr",    "%n",             E_NONE, F_WN)
X(SHLL2,       "0100nnnn00001000", "shll2",   "%n",             E_NONE, F_WN)
X(SHLR2,       "0100nnnn00001001", "shlr2",   "%n",             E_NONE, F_WN)
X(SHLL8,       "0100nnnn00011000", "shll8",   "%n",             E_NONE, F_WN)
X(SHLR8,       "0100nnnn00011001", "shlr8",   "%n",             E_NONE, F_WN)
X(SHLL16,      "0100nnnn00101000", "shll16",  "%n",             E_NONE, F_WN)
X(SHLR16,      "0100nnnn00101001", "shlr16",  "%n",             E_NONE, F_WN)

/* ---- branches ---- */
X(BF,          "10001011dddddddd", "bf",      "%a",             E_BR8,  F_BRANCH | F_COND)
X(BFS,         "10001111dddddddd", "bf.s",    "%a",             E_BR8,  F_BRANCH | F_COND | F_DELAY)
X(BT,          "10001001dddddddd", "bt",      "%a",             E_BR8,  F_BRANCH | F_COND)
X(BTS,         "10001101dddddddd", "bt.s",    "%a",             E_BR8,  F_BRANCH | F_COND | F_DELAY)
X(BRA,         "1010dddddddddddd", "bra",     "%a",             E_BR12, F_BRANCH | F_DELAY)
X(BRAF,        "0000nnnn00100011", "braf",    "%n",             E_NONE, F_BRANCH | F_DELAY | F_INDIRECT)
X(BSR,         "1011dddddddddddd", "bsr",     "%a",             E_BR12, F_CALL | F_DELAY)
X(BSRF,        "0000nnnn00000011", "bsrf",    "%n",             E_NONE, F_CALL | F_DELAY | F_INDIRECT)
X(JMP,         "0100nnnn00101011", "jmp",     "@%n",            E_NONE, F_BRANCH | F_DELAY | F_INDIRECT)
X(JSR,         "0100nnnn00001011", "jsr",     "@%n",            E_NONE, F_CALL | F_DELAY | F_INDIRECT)
X(RTS,         "0000000000001011", "rts",     "",               E_NONE, F_RETURN | F_DELAY)

/* ---- system control ---- */
X(CLRMAC,      "0000000000101000", "clrmac",  "",               E_NONE, 0)
X(CLRS,        "0000000001001000", "clrs",    "",               E_NONE, 0)
X(CLRT,        "0000000000001000", "clrt",    "",               E_NONE, 0)
X(LDC_SR,      "0100nnnn00001110", "ldc",     "%n,sr",          E_NONE, F_PRIV)
X(LDC_GBR,     "0100nnnn00011110", "ldc",     "%n,gbr",         E_NONE, 0)
X(LDC_VBR,     "0100nnnn00101110", "ldc",     "%n,vbr",         E_NONE, F_PRIV)
X(LDC_SSR,     "0100nnnn00111110", "ldc",     "%n,ssr",         E_NONE, F_PRIV)
X(LDC_SPC,     "0100nnnn01001110", "ldc",     "%n,spc",         E_NONE, F_PRIV)
X(LDC_DBR,     "0100nnnn11111010", "ldc",     "%n,dbr",         E_NONE, F_PRIV)
X(LDC_BANK,    "0100nnnn1mmm1110", "ldc",     "%n,%k",          E_NONE, F_PRIV)
X(LDCL_SR,     "0100nnnn00000111", "ldc.l",   "@%n+,sr",        E_NONE, F_LOAD | F_PRIV | F_WN)
X(LDCL_GBR,    "0100nnnn00010111", "ldc.l",   "@%n+,gbr",       E_NONE, F_LOAD | F_WN)
X(LDCL_VBR,    "0100nnnn00100111", "ldc.l",   "@%n+,vbr",       E_NONE, F_LOAD | F_PRIV | F_WN)
X(LDCL_SSR,    "0100nnnn00110111", "ldc.l",   "@%n+,ssr",       E_NONE, F_LOAD | F_PRIV | F_WN)
X(LDCL_SPC,    "0100nnnn01000111", "ldc.l",   "@%n+,spc",       E_NONE, F_LOAD | F_PRIV | F_WN)
X(LDCL_DBR,    "0100nnnn11110110", "ldc.l",   "@%n+,dbr",       E_NONE, F_LOAD | F_PRIV | F_WN)
X(LDCL_BANK,   "0100nnnn1mmm0111", "ldc.l",   "@%n+,%k",        E_NONE, F_LOAD | F_PRIV | F_WN)
X(LDS_MACH,    "0100nnnn00001010", "lds",     "%n,mach",        E_NONE, 0)
X(LDS_MACL,    "0100nnnn00011010", "lds",     "%n,macl",        E_NONE, 0)
X(LDS_PR,      "0100nnnn00101010", "lds",     "%n,pr",          E_NONE, 0)
X(LDSL_MACH,   "0100nnnn00000110", "lds.l",   "@%n+,mach",      E_NONE, F_LOAD | F_WN)
X(LDSL_MACL,   "0100nnnn00010110", "lds.l",   "@%n+,macl",      E_NONE, F_LOAD | F_WN)
X(LDSL_PR,     "0100nnnn00100110", "lds.l",   "@%n+,pr",        E_NONE, F_LOAD | F_WN)
X(LDTLB,       "0000000000111000", "ldtlb",   "",               E_NONE, F_PRIV)
X(OCBI,        "0000nnnn10010011", "ocbi",    "@%n",            E_NONE, 0)
X(OCBP,        "0000nnnn10100011", "ocbp",    "@%n",            E_NONE, 0)
X(OCBWB,       "0000nnnn10110011", "ocbwb",   "@%n",            E_NONE, 0)
X(PREF,        "0000nnnn10000011", "pref",    "@%n",            E_NONE, 0)
X(RTE,         "0000000000101011", "rte",     "",               E_NONE, F_RETURN | F_DELAY | F_PRIV)
X(SETS,        "0000000001011000", "sets",    "",               E_NONE, 0)
X(SETT,        "0000000000011000", "sett",    "",               E_NONE, 0)
X(SLEEP,       "0000000000011011", "sleep",   "",               E_NONE, F_PRIV)
X(STC_SR,      "0000nnnn00000010", "stc",     "sr,%n",          E_NONE, F_PRIV | F_WN)
X(STC_GBR,     "0000nnnn00010010", "stc",     "gbr,%n",         E_NONE, F_WN)
X(STC_VBR,     "0000nnnn00100010", "stc",     "vbr,%n",         E_NONE, F_PRIV | F_WN)
X(STC_SSR,     "0000nnnn00110010", "stc",     "ssr,%n",         E_NONE, F_PRIV | F_WN)
X(STC_SPC,     "0000nnnn01000010", "stc",     "spc,%n",         E_NONE, F_PRIV | F_WN)
X(STC_SGR,     "0000nnnn00111010", "stc",     "sgr,%n",         E_NONE, F_PRIV | F_WN)
X(STC_DBR,     "0000nnnn11111010", "stc",     "dbr,%n",         E_NONE, F_PRIV | F_WN)
X(STC_BANK,    "0000nnnn1mmm0010", "stc",     "%k,%n",          E_NONE, F_PRIV | F_WN)
X(STCL_SR,     "0100nnnn00000011", "stc.l",   "sr,@-%n",        E_NONE, F_STORE | F_PRIV | F_WN)
X(STCL_GBR,    "0100nnnn00010011", "stc.l",   "gbr,@-%n",       E_NONE, F_STORE | F_WN)
X(STCL_VBR,    "0100nnnn00100011", "stc.l",   "vbr,@-%n",       E_NONE, F_STORE | F_PRIV | F_WN)
X(STCL_SSR,    "0100nnnn00110011", "stc.l",   "ssr,@-%n",       E_NONE, F_STORE | F_PRIV | F_WN)
X(STCL_SPC,    "0100nnnn01000011", "stc.l",   "spc,@-%n",       E_NONE, F_STORE | F_PRIV | F_WN)
X(STCL_SGR,    "0100nnnn00110010", "stc.l",   "sgr,@-%n",       E_NONE, F_STORE | F_PRIV | F_WN)
X(STCL_DBR,    "0100nnnn11110010", "stc.l",   "dbr,@-%n",       E_NONE, F_STORE | F_PRIV | F_WN)
